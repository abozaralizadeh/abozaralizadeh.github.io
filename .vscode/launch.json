{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Preview site (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:8765/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "serve site"
    },
    {
      "name": "Preview site, phone size (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:8765/",
      "webRoot": "${workspaceFolder}",
      "runtimeArgs": [
        "--window-size=390,844"
      ],
      "preLaunchTask": "serve site"
    }
  ]
}
